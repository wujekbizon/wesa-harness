{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WESA Harness Agent Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "role", "defaultProvider", "allowedProviders", "taskTypes", "systemPrompt", "capabilityManifest", "source"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "defaultProvider": { "type": "string", "minLength": 1 },
    "allowedProviders": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "defaultModel": { "type": ["string", "null"] },
    "taskTypes": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "systemPrompt": { "type": "string", "minLength": 50 },
    "capabilityManifest": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 }
  }
}
