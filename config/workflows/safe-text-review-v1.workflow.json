{
  "id": "safe-text-review-v1",
  "version": 1,
  "name": "Safe text review",
  "description": "W1 drafts Markdown and Q1 reviews the accepted draft.",
  "stages": [
    {
      "id": "draft",
      "name": "Draft",
      "kind": "task",
      "dependsOn": [],
      "agentId": "W1",
      "taskType": "write",
      "providerId": null,
      "model": null,
      "promptTemplate": "{input}",
      "outputFile": "draft.md",
      "attachmentStages": [],
      "maxAttempts": 2,
      "repeatCount": 1,
      "condition": "on-success"
    },
    {
      "id": "review",
      "name": "Review",
      "kind": "task",
      "dependsOn": ["draft"],
      "agentId": "Q1",
      "taskType": "review",
      "providerId": null,
      "model": null,
      "promptTemplate": "Review the attached draft. Return a concise Markdown quality report with concrete corrections.",
      "outputFile": "review.md",
      "attachmentStages": ["draft"],
      "maxAttempts": 2,
      "repeatCount": 1,
      "condition": "on-success"
    }
  ]
}
